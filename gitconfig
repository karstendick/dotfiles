[user]
name = Joshua Karstendick
email = joshdick@gmail.com

[color]
branch = auto
diff = auto
status = auto

[color "branch"]
current = yellow reverse
local = yellow
remote = green

[color "diff"]
meta = yellow bold
frag = magenta bold
old = red
new = cyan

[color "status"]
added = yellow
changed = green
untracked = cyan

# Try to keep this in sync with Bash-it (https://github.com/Bash-it/bash-it/blob/master/aliases/available/git.aliases.bash)
# in case I ever switch to that.
# The approach here is to abbreviate common git commands,
# not invent a new vocabulary
[alias]
st = status
co = checkout
dfc = diff --cached
count = shortlog -sn
ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
log1 = log --graph --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%cr)%C(reset) %C(white)%s%C(reset) %C(bold white)- %cn%C(reset)%C(bold yellow)%d%C(reset)' --abbrev-commit --date=relative
log2 = log --graph --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%cD%C(reset) %C(bold green)(%cr)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(bold white)- %cn%C(reset)' --abbrev-commit

[core]
excludesfile = ~/.gitignore
editor = emacs

[pull]
rebase = false

# Only adopt an upstream automatically when the remote branch has the same name
# as the new local branch. The default (true) means `git checkout -b feature
# origin/main` silently sets feature's upstream to main, which combined with a
# bare `git push` writes straight to main.
[branch]
autoSetupMerge = simple

[push]
# simple refuses to push when the upstream's name differs from the current
# branch's name -- the guardrail against the above. Was `upstream`, which pushes
# to the upstream's name instead and so has no such check.
default = simple
autoSetupRemote = true
