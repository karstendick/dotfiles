# Adopted from https://github.com/mathiasbynens/dotfiles

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
	export TERM='gnome-256color';
elif infocmp xterm-256color >/dev/null 2>&1; then
	export TERM='xterm-256color';
fi;

# How long a command has to run before the prompt reports its duration. Nearly everything finishes
# in well under a second and its timing isn't interesting, so those stay silent.
PROMPT_DURATION_THRESHOLD_MS=1000;

prompt_git() {
	local s='';
	local u='';
	local branchName='';

	# Check if the current directory is in a Git repository.
	if git rev-parse --is-inside-work-tree &>/dev/null; then

		# check if the current directory is in .git before running git checks
		if [ "$(git rev-parse --is-inside-git-dir 2> /dev/null)" == 'false' ]; then

			# Ensure the index is up to date.
			git update-index --really-refresh -q &>/dev/null;

			# Check for uncommitted changes in the index.
			if ! git diff --quiet --ignore-submodules --cached; then
				s+='+';
			fi;

			# Check for unstaged changes.
			if ! git diff-files --quiet --ignore-submodules --; then
				s+='!';
			fi;

			# Check for untracked files.
			if [ -n "$(git ls-files --others --exclude-standard)" ]; then
				s+='?';
			fi;

			# Check for stashed files.
			if git rev-parse --verify refs/stash &>/dev/null; then
				s+='$';
			fi;

			# Check how far the branch has diverged from its upstream. One call covers both
			# directions: --left-right counts each side of the symmetric difference, left being the
			# commits only the upstream has. Exits non-zero on a branch with no upstream, which
			# leaves this empty.
			local counts;
			if counts="$(git rev-list --count --left-right '@{upstream}...HEAD' 2> /dev/null)" \
				&& [ -n "${counts}" ]; then
				local behind="${counts%%[[:space:]]*}";
				local ahead="${counts##*[[:space:]]}";
				[ "${ahead}" == '0' ] || u+="↑${ahead}";
				[ "${behind}" == '0' ] || u+="↓${behind}";
			fi;

		fi;

		# Get the short symbolic ref.
		# If HEAD isn’t a symbolic ref, get the short SHA for the latest commit
		# Otherwise, just give up.
		branchName="$(git symbolic-ref --quiet --short HEAD 2> /dev/null || \
			git rev-parse --short HEAD 2> /dev/null || \
			echo '(unknown)')";

		[ -n "${u}" ] && u=" ${cyan}${u}";
		[ -n "${s}" ] && s=" [${s}]";

		echo -e "${1}${branchName}${u}${blue}${s}";
	else
		return;
	fi;
}

# Save the exit status of the last command, before PS1 is expanded. Registering this twice would
# make the second copy read the first copy's status — always 0 — so no failure would ever show;
# hence the guard. The direnv hook in bash_profile preserves $? across PROMPT_COMMAND, so the
# status that lands here is the real one even though that hook runs first.
prompt_save_status() {
	lastExitStatus=$?;
}
if [[ ";${PROMPT_COMMAND:-};" != *";prompt_save_status;"* ]]; then
	PROMPT_COMMAND="prompt_save_status${PROMPT_COMMAND:+;$PROMPT_COMMAND}";
fi;

prompt_exit_status() {
	# Read from prompt_save_status rather than straight from $?: the $(prompt_git) earlier in PS1
	# overwrites $? with its own status before this function is ever called.
	[ "${lastExitStatus:-0}" == '0' ] && return;

	echo -e " ${1}✘${lastExitStatus}";
}

# Turn microseconds into something readable: tenths of a second below 10s, whole seconds up to a
# minute, then compound units. Truncated rather than rounded, so the prompt never claims more time
# than the command actually took. Hours are unbounded — an overnight run reads as 14h20m.
prompt_format_duration() {
	local us="${1}";
	local seconds=$(( us / 1000000 ));

	if [ "${us}" -lt 10000000 ]; then
		printf '%d.%ds' "${seconds}" $(( us / 100000 % 10 ));
	elif [ "${seconds}" -lt 60 ]; then
		printf '%ds' "${seconds}";
	elif [ "${seconds}" -lt 3600 ]; then
		printf '%dm%02ds' $(( seconds / 60 )) $(( seconds % 60 ));
	else
		printf '%dh%02dm' $(( seconds / 3600 )) $(( seconds % 3600 / 60 ));
	fi;
}

# Stamp the time a command starts. $EPOCHREALTIME is seconds with a microsecond fraction; deleting
# the decimal point leaves plain microseconds, which is what bash can actually do arithmetic on (it
# has no floating point).
#
# PS0 is expanded after a command is read and before it runs, which makes it a preexec hook that
# costs no subprocess and that nothing else competes for. A DEBUG trap is the usual way to do this
# and is the wrong tool here: VS Code's shell integration claims that trap, and its logic for
# detecting and chaining a pre-existing one can't see ours, because a DEBUG trap is invisible from
# inside a function unless functrace is on — and turning functrace on makes every command inside
# every function pay for a trap dispatch, which measured ~6x slower on function-heavy work.
#
# Whatever PS0 expands to is printed, so the stamp rides along inside an array subscript:
# promptTimerVoid is never assigned, so the expansion performs the arithmetic and produces nothing.
# shellcheck disable=SC2016 # single quotes are the point: bash expands this per command, not now.
PS0='${promptTimerVoid[$((promptTimerStart=${EPOCHREALTIME/./}))]}';

prompt_timer_stop() {
	local elapsed;
	promptDuration='';

	# The previous prompt unset this and only PS0 re-stamps it, so pressing Enter on an empty line —
	# where no command runs and PS0 never expands — reports nothing instead of a stale duration.
	if [ -n "${promptTimerStart:-}" ]; then
		elapsed=$(( ${EPOCHREALTIME/./} - promptTimerStart ));
		if [ "${elapsed}" -ge $(( PROMPT_DURATION_THRESHOLD_MS * 1000 )) ]; then
			# Fold in the leading space and the color here rather than in PS1, so that a fast command
			# leaves the prompt byte for byte what it was before any of this existed.
			promptDuration=" ${yellow}$(prompt_format_duration "${elapsed}")";
		fi;
		unset promptTimerStart;
	fi;
}
# Appended, so this lands after prompt_save_status: clobbering $? is fine once the status is saved.
if [[ ";${PROMPT_COMMAND:-};" != *";prompt_timer_stop;"* ]]; then
	PROMPT_COMMAND="${PROMPT_COMMAND:+${PROMPT_COMMAND};}prompt_timer_stop";
fi;

if tput setaf 1 &> /dev/null; then
	tput sgr0; # reset colors
	bold=$(tput bold);
	reset=$(tput sgr0);
	# Solarized colors, taken from http://git.io/solarized-colors.
	black=$(tput setaf 0);
	blue=$(tput setaf 33);
	cyan=$(tput setaf 37);
	green=$(tput setaf 64);
	orange=$(tput setaf 166);
	purple=$(tput setaf 125);
	red=$(tput setaf 124);
	violet=$(tput setaf 61);
	white=$(tput setaf 15);
	yellow=$(tput setaf 136);
else
	bold='';
	reset="\e[0m";
	black="\e[1;30m";
	blue="\e[1;34m";
	cyan="\e[1;36m";
	green="\e[1;32m";
	orange="\e[1;33m";
	purple="\e[1;35m";
	red="\e[1;31m";
	violet="\e[1;35m";
	white="\e[1;37m";
	yellow="\e[1;33m";
fi;

# Highlight the user name when logged in as root.
if [[ "${USER}" == "root" ]]; then
	userStyle="${red}";
else
	userStyle="${orange}";
fi;

# Set the terminal title to the current working directory.
PS1="\[\033]0;\w\007\]";
PS1+="\[${bold}\]\n"; # newline
PS1+="\[${userStyle}\]\u"; # username
PS1+="\[${white}\] in ";
PS1+="\[${green}\]\w"; # working directory
PS1+="\$(prompt_git \"${white} on ${violet}\")"; # Git repository details
PS1+="\${promptDuration}"; # how long the last command took, if it was slow
PS1+="\$(prompt_exit_status \"${red}\")"; # exit status of the last command, if it failed
PS1+="\n";
PS1+="\[${white}\]\$ \[${reset}\]"; # `$` (and reset color)
export PS1;

PS2="\[${yellow}\]→ \[${reset}\]";
export PS2;
